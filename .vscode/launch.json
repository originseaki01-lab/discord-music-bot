{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Discord Music Bot",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/index.ts",
      "runtimeArgs": ["--import", "tsx"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3000"
      }
    }
  ]
}